# Bắt buộc trên Render
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_CREDENTIALS_JSON=YOUR_SERVICE_ACCOUNT_JSON
ZALO_ACCESS_TOKEN=YOUR_ZALO_ACCESS_TOKEN
INTERNAL_API_KEY=YOUR_LONG_RANDOM_INTERNAL_KEY

# Dùng cho cơ chế tự động làm mới token Zalo hiện tại
ZALO_APP_ID=YOUR_ZALO_APP_ID
ZALO_APP_SECRET=YOUR_ZALO_APP_SECRET
ZALO_REFRESH_TOKEN=YOUR_ZALO_REFRESH_TOKEN

# AI Optional
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=

# Vận hành
DEBUG_MODE=FALSE
SHEET_CACHE_TTL_SECONDS=300
SHEET_CACHE_MAX_STALE_SECONDS=1800
HEALTH_CHECK_TTL_SECONDS=300
MESSAGE_DEDUP_TTL_SECONDS=600
MAX_PROCESSED_MESSAGES=5000
MAX_ZALO_TEXT_LENGTH=1900

# Chỉ dùng khi chạy cục bộ thay cho GOOGLE_CREDENTIALS_JSON
# GOOGLE_CREDENTIALS_FILE=credentials.json
