# Vận hành
DEBUG_MODE=FALSE
SHEET_CACHE_TTL_SECONDS=300
SHEET_CACHE_MAX_STALE_SECONDS=1800
HEALTH_CHECK_TTL_SECONDS=300
MESSAGE_DEDUP_TTL_SECONDS=600
